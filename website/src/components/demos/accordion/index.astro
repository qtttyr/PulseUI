---
import IconBlock from "../../IconBlock.astro";

interface Props {
  preview?: boolean;
}
const { preview = false } = Astro.props;
---
{
  preview ? (
    <div class="pv" style="place-items:start center; padding-top:28px">
      <span class="pv-grid"></span>
      <span class="pv-glow"></span>
      <div class="pv-scene">
        <div class="acc">
          <div class="iq open" style="--i:0">
            <span class="head">What is Pulse UI?</span>
            <div class="body"><div class="inner">Tokens, springs, accessibility — out of the box.</div></div>
          </div>
          <div class="iq" style="--i:1">
            <span class="head">Free forever?</span>
            <div class="body"><div class="inner">MIT licensed. Yes.</div></div>
          </div>
        </div>
      </div>
    </div>
  ) : (
    <div class="dk-stage dk-stage--top" style="justify-content: center">
      <div class="dk-acc" data-acc style="max-width: 480px; width: 480px">
        <div class="dk-acc-item is-open">
          <button class="dk-acc-btn" data-acc-btn>
            What is Pulse UI?
            <span class="dk-acc-caret"><IconBlock name="down" size={15} /></span>
          </button>
          <div class="dk-acc-body" data-acc-body><div class="dk-acc-inner">
            A premium copy-paste component library for SwiftUI — themed through tokens, animated with springs, accessible by default.
          </div></div>
        </div>
        <div class="dk-acc-item">
          <button class="dk-acc-btn" data-acc-btn>
            How do I install one component?
            <span class="dk-acc-caret"><IconBlock name="down" size={15} /></span>
          </button>
          <div class="dk-acc-body" data-acc-body><div class="dk-acc-inner">
            Paste its source file into your project and call it like any SwiftUI view. Tokens do the rest.
          </div></div>
        </div>
        <div class="dk-acc-item">
          <button class="dk-acc-btn" data-acc-btn>
            Is it really free?
            <span class="dk-acc-caret"><IconBlock name="down" size={15} /></span>
          </button>
          <div class="dk-acc-body" data-acc-body><div class="dk-acc-inner">
            Yes — MIT licensed, open source, forever, even in commercial projects.
          </div></div>
        </div>
      </div>
    </div>
  )
}
<style>
  .acc {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 260px;
  }
  .iq {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--panel) 88%, transparent);
    overflow: hidden;
    animation: ac-float 5.2s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.8s);
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 14px;
    font-size: 13px;
    font-weight: 600;
  }
  .head::after {
    content: "⌄";
    color: var(--fg-tertiary);
    transition: transform 0.2s ease;
  }
  .iq.open .head::after {
    transform: rotate(180deg);
    color: var(--accent-ink);
  }
  .body {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.3s ease;
  }
  .iq:not(.open) .body {
    grid-template-rows: 0fr;
  }
  .inner {
    overflow: hidden;
    padding: 0 14px 12px;
    font-size: 12px;
    color: var(--fg-secondary);
    min-height: 0;
  }
  .iq.open {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--accent) 18%, transparent);
  }
  @keyframes ac-float {
    0%, 18%, 100% { transform: translateY(0) scale(1); }
    28%, 40% { transform: translateY(-3px) scale(1.01); }
  }
</style>