---
import IconBlock from "../../IconBlock.astro";

interface Props {
  preview?: boolean;
}
const { preview = false } = Astro.props;
---
{
  preview ? (
    <div class="pv">
      <span class="pv-grid"></span>
      <span class="pv-glow"></span>
      <div class="pv-scene">
        <div class="chips">
          <span class="chip on">SwiftUI</span>
          <span class="chip">Combine</span>
          <span class="chip">Metal</span>
          <span class="chip off">VisionOS</span>
        </div>
      </div>
    </div>
  ) : (
    <div class="dk-stage dk-stage--col" style="gap: 16px; max-width: 480px">
      <div class="dk-chip-row" data-chips data-single style="display: flex; gap: 9px; flex-wrap: wrap; justify-content: center">
        {["All", "Swift", "SwiftUI", "Combine"].map((label, ci) => (
          <button class:list={["dk-chip", label === "SwiftUI" && "is-on"]} data-chip>
            <svg class="dk-chip-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L19 7"/></svg>
            {label}
          </button>
        ))}
      </div>
      <div style="display: flex; gap: 9px; flex-wrap: wrap; justify-content: center">
        <button class="dk-chip dk-chip--tinted is-on" data-chip>
          <svg class="dk-chip-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L19 7"/></svg>
          Tinted
        </button>
        <button class="dk-chip dk-chip--outlined" data-chip>
          <svg class="dk-chip-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L19 7"/></svg>
          Outlined
        </button>
        <button class="dk-chip dk-chip--glass" data-chip>
          <svg class="dk-chip-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L19 7"/></svg>
          Glass
        </button>
        <button class="dk-chip is-on" data-chip disabled>Disabled</button>
      </div>
    </div>
  )
}
<style>
  .chips {
    display: flex;
    gap: 9px;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 220px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 99px;
    border: 1px solid var(--border);
    color: var(--fg-secondary);
    animation: ch-pop 5s ease-in-out infinite;
  }
  .chip.on {
    background: var(--accent);
    color: var(--accent-contrast);
    border-color: transparent;
    animation-delay: 0.4s;
    box-shadow: 0 4px 16px color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .chip.off {
    opacity: 0.4;
    animation-delay: 0.8s;
  }
  .chip:nth-child(3) { animation-delay: 1.2s; }
  @keyframes ch-pop {
    0%, 62%, 100% { transform: translateY(0) scale(1); }
    72% { transform: translateY(-3px) scale(1.06); }
    84% { transform: translateY(0) scale(0.97); }
  }
</style>