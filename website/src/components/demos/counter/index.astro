---
interface Props {
  preview?: boolean;
}
const { preview = false } = Astro.props;
---
{
  preview ? (
    <div class="pv">
      <span class="pv-grid"></span>
      <span class="pv-glow"></span>
      <div class="pv-scene col">
        <span class="num" data-n="12890">
          <i>1</i><i>2</i><i>8</i><i>9</i><i>0</i>
        </span>
        <span class="meta">digit-roll · spring</span>
      </div>
    </div>
  ) : (
    <>
      <div class="dk-toolbar"><button class="dk-btn--micro" data-anim-replay>replay</button></div>
      <div class="dk-stage dk-stage--col" data-anim style="min-height: 260px">
        <div class="dk-counter" data-count="12890">0</div>
        <span class="dk-type dk-type--mono">rolls to 12,890 with a spring</span>
      </div>
    </>
  )
}
<style>
  .col {
    flex-direction: column;
    gap: 12px;
  }
  .num {
    display: flex;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 44px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--fg);
  }
  .num i {
    position: relative;
    display: block;
    overflow: hidden;
    height: 0.86em;
  }
  .num i::after {
    content: "0123456789";
    position: absolute;
    left: 0;
    top: 0.86em;
    animation: cnt-roll 3.6s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }
  .num i:nth-child(1)::after { animation-delay: 0.05s; }
  .num i:nth-child(2)::after { animation-delay: 0.12s; }
  .num i:nth-child(3)::after { animation-delay: 0.19s; }
  .num i:nth-child(4)::after { animation-delay: 0.26s; }
  .num i:nth-child(5)::after { animation-delay: 0.33s; }
  .meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-tertiary);
  }
  @keyframes cnt-roll {
    0% { transform: translateY(0); }
    14% { transform: translateY(calc(-0.86em * 9)); }
    30%, 100% { transform: translateY(calc(-0.86em * 9)); }
  }
</style>