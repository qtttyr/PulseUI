---
import IconBlock from "../../IconBlock.astro";

interface Props {
  preview?: boolean;
}
const { preview = false } = Astro.props;
---
{
  preview ? (
    <div class="pv">
      <span class="pv-grid"></span>
      <span class="pv-glow"></span>
      <div class="pv-scene">
        <div class="empty">
          <span class="blob">
            <IconBlock name="tray" size={26} />
            <i class="o1"></i>
            <i class="o2"></i>
          </span>
          <b>No items yet</b>
          <span class="m">Start by adding your first one.</span>
        </div>
      </div>
    </div>
  ) : (
    <div class="dk-stage">
      <div class="dk-empty">
        <span class="dk-empty-ic"><IconBlock name="tray" size={30} /></span>
        <span class="dk-empty-t">No items yet</span>
        <p class="dk-empty-m">Items you add will show up here automatically. Start by adding your first one.</p>
        <button class="dk-btn dk-btn--primary dk-btn--sm" data-load="empty"><span class="dk-btn-label">Add item</span><span class="dk-spin"></span></button>
      </div>
    </div>
  )
}
<style>
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9px;
    text-align: center;
  }
  .blob {
    position: relative;
    display: grid;
    place-items: center;
    width: 74px;
    height: 74px;
    border-radius: 24px;
    background: color-mix(in srgb, var(--accent) 14%, var(--panel));
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    color: var(--accent-ink);
    animation: pv-float 4.8s ease-in-out infinite;
  }
  .blob i {
    position: absolute;
    inset: 0;
    border-radius: 24px;
    border: 1px solid var(--accent);
    opacity: 0;
    animation: es-ring 3.4s ease-out infinite;
  }
  .o2 { animation-delay: 1.1s; }
  .empty b {
    font-size: 15px;
    font-weight: 700;
  }
  .empty .m {
    font-size: 11px;
    color: var(--fg-tertiary);
    max-width: 150px;
  }
  @keyframes es-ring {
    0% { transform: scale(0.9); opacity: 0.7; }
    70%, 100% { transform: scale(1.6); opacity: 0; }
  }
</style>