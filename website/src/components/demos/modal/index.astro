---
import IconBlock from "../../IconBlock.astro";

interface Props {
  preview?: boolean;
}
const { preview = false } = Astro.props;
---
{
  preview ? (
    <div class="pv" style="place-items:start center; padding-top:26px">
      <span class="pv-grid"></span>
      <span class="pv-glow"></span>
      <div class="pv-scene">
        <div class="card">
          <button class="x">×</button>
          <span class="t">Upgrade to Pro</span>
          <span class="m">Unlock every component, the full token set and all future drops.</span>
          <span class="act">Upgrade — $9/mo</span>
        </div>
      </div>
    </div>
  ) : (
    <div class="dk-stage">
      <button class="dk-btn dk-btn--primary dk-btn--md" data-modal-open>Open modal</button>
      <button class="dk-btn dk-btn--outline dk-btn--md" data-modal-open="sparkle">Upgrade flow</button>
      <div data-modal hidden>
        <div class="dk-modal-scrim" data-modal-close></div>
        <div class="dk-modal-card">
          <button class="dk-modal-x" data-modal-close>×</button>
          <span class="dk-type dk-type--title2">Upgrade to Pro</span>
          <p class="dk-type dk-type--callout">Unlock every component, the full token set and all future drops. One price, forever.</p>
          <button class="dk-btn dk-btn--gradient dk-btn--block" data-modal-close>Upgrade — $9/mo</button>
          <button class="dk-btn dk-btn--ghost dk-btn--sm dk-btn--link" data-modal-close>Maybe later</button>
        </div>
      </div>
      <div data-modal="sparkle" hidden>
        <div class="dk-modal-scrim" data-modal-close></div>
        <div class="dk-modal-card">
          <button class="dk-modal-x" data-modal-close>×</button>
          <span class="dk-modal-spark"><IconBlock name="sparkle" size={26} /></span>
          <span class="dk-type dk-type--title2">You're on the list</span>
          <p class="dk-type dk-type--callout">We'll email you the sparkle release when it ships — no spam, ever.</p>
          <button class="dk-btn dk-btn--primary dk-btn--block" data-modal-close>Nice</button>
        </div>
      </div>
    </div>
  )
}
<style>
  .card {
    position: relative;
    width: 236px;
    border-radius: var(--radius-xl);
    border: 1px solid color-mix(in srgb, var(--accent) 32%, transparent);
    background: linear-gradient(155deg, color-mix(in srgb, var(--signal) 14%, var(--panel)), var(--panel) 45%, color-mix(in srgb, var(--accent) 14%, var(--panel)));
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    box-shadow: 0 24px 60px color-mix(in srgb, var(--accent) 22%, transparent);
    animation: md-breathe 5s ease-in-out infinite;
  }
  .x {
    position: absolute;
    top: 12px;
    right: 14px;
    border: 0;
    background: none;
    color: var(--fg-tertiary);
    font-size: 18px;
  }
  .t {
    font-size: 17px;
    font-weight: 750;
    letter-spacing: -0.01em;
  }
  .m {
    font-size: 12px;
    color: var(--fg-secondary);
    line-height: 1.5;
  }
  .act {
    margin-top: 7px;
    text-align: center;
    font-size: 13px;
    font-weight: 700;
    padding: 12px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--accent), var(--signal));
    color: #07110a;
    box-shadow: 0 8px 22px color-mix(in srgb, var(--accent) 40%, transparent);
  }
  @keyframes md-breathe {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
</style>