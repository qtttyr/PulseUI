---
interface Props {
  preview?: boolean;
}
const { preview = false } = Astro.props;
---
{
  preview ? (
    <div class="pv">
      <span class="pv-grid"></span>
      <span class="pv-glow"></span>
      <div class="pv-scene">
        <div class="seg">
          <span class="thumb a"></span>
          <button>Tab</button>
          <button>View</button>
          <button disabled>Auto</button>
        </div>
      </div>
    </div>
  ) : (
    <>
      <div class="dk-toolbar"><button class="dk-btn--micro" data-tabbar-replay>other style</button></div>
      <div class="dk-stage dk-stage--col" style="gap: 26px">
        <div class="dk-seg" data-seg>
          <button class="dk-seg-btn is-on" data-seg-btn style="width: 96px">Segments</button>
          <button class="dk-seg-btn" data-seg-btn style="width: 90px">Manual</button>
          <button class="dk-seg-btn" data-seg-btn style="width: 82px">Auto</button>
          <span class="dk-seg-thumb"></span>
        </div>
        <div class="dk-seg dk-seg--pill" data-seg>
          <button class="dk-seg-btn is-on" data-seg-btn style="width: 100px">Weekly</button>
          <button class="dk-seg-btn" data-seg-btn style="width: 100px">Monthly</button>
          <button class="dk-seg-btn" data-seg-btn style="width: 100px" disabled>Yearly</button>
          <span class="dk-seg-thumb"></span>
        </div>
      </div>
    </>
  )
}
<style>
  .seg {
    position: relative;
    display: flex;
    gap: 4px;
    padding: 5px;
    border: 1px solid var(--border);
    border-radius: 13px;
    background: var(--panel-2);
  }
  .seg button {
    position: relative;
    z-index: 1;
    width: 78px;
    padding: 9px 4px;
    border: 0;
    background: transparent;
    color: var(--fg-secondary);
    font-size: 12px;
    font-weight: 600;
    border-radius: 9px;
  }
  .seg button:disabled {
    opacity: 0.4;
  }
  .thumb {
    position: absolute;
    left: 5px;
    top: 5px;
    bottom: 5px;
    width: 78px;
    border-radius: 9px;
    background: var(--accent);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--accent) 42%, transparent);
    animation: pk-slide 4.6s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
  }
  @keyframes pk-slide {
    0%, 18% { transform: translateX(0); }
    30%, 62% { transform: translateX(82px); }
    74%, 100% { transform: translateX(0); }
  }
</style>