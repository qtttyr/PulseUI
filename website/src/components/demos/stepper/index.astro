---
interface Props {
  preview?: boolean;
}
const { preview = false } = Astro.props;
---
{
  preview ? (
    <div class="pv">
      <span class="pv-grid"></span>
      <span class="pv-glow"></span>
      <div class="pv-scene">
        <div class="step">
          <button>{""}−</button>
          <span class="val" data-v="40">40<small>/100</small></span>
          <button>+</button>
        </div>
      </div>
    </div>
  ) : (
    <div class="dk-stage dk-stage--col" style="gap: 18px">
      <div class="dk-step" data-step data-min="0" data-max="100" data-step="5">
        <button class="dk-step-btn" data-step-btn="-1" aria-label="decrease">−</button>
        <span class="dk-step-txt"><b data-val="40">40</b><small>/ 100</small></span>
        <button class="dk-step-btn" data-step-btn="1" aria-label="increase">+</button>
      </div>
      <div class="dk-step dk-step--small" data-step data-min="-5" data-max="5" data-step="1">
        <button class="dk-step-btn" data-step-btn="-1" aria-label="decrease">−</button>
        <span class="dk-step-txt"><b data-val="0">0</b></span>
        <button class="dk-step-btn" data-step-btn="1" aria-label="increase">+</button>
      </div>
      <span class="dk-note">step 5 · clamped 0…100 · haptics on press</span>
    </div>
  )
}
<style>
  .step {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .step button {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    border: 1px solid var(--border-strong);
    background: var(--panel-2);
    color: var(--fg-secondary);
    font-size: 18px;
    font-weight: 600;
    animation: st-bounce 4.4s ease-in-out infinite;
  }
  .step button:last-child {
    animation-delay: 1s;
  }
  .val b {
    font-size: 22px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  .val small {
    font-size: 11px;
    color: var(--fg-tertiary);
    margin-left: 4px;
  }
  .val {
    min-width: 76px;
    text-align: center;
  }
  @keyframes st-bounce {
    0%, 62%, 100% { transform: translateY(0) scale(1); }
    70% { transform: translateY(-3px) scale(1.06); }
    80% { transform: translateY(0) scale(0.95); }
  }
</style>