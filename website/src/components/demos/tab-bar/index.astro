---
import IconBlock from "../../IconBlock.astro";

interface Props {
  preview?: boolean;
}
const { preview = false } = Astro.props;
---
{
  preview ? (
    <div class="pv" style="place-items:start center; padding-top:34px">
      <span class="pv-grid"></span>
      <span class="pv-glow"></span>
      <div class="pv-scene colx">
        <div class="bbar">
          <span class="tbactive">
            <span class="icon"><IconBlock name="house" size={16} /></span>
            Home
          </span>
          <span class="tb">
            <span class="icon"><IconBlock name="search" size={16} /></span>
            Search
          </span>
          <span class="tb">
            <span class="icon"><IconBlock name="bell" size={16} /></span>
            Alerts
          </span>
        </div>
      </div>
    </div>
  ) : (
    <div class="dk-stage dk-stage--top" style="min-height: 280px; justify-content: center">
      <div class="dk-tabring">
        <div class="dk-tabbar" data-tabbar data-tabs-msg="Home">
          <button class="dk-tab is-on" data-tab="Home">
            <span class="dk-tab-pill"></span>
            <span class="dk-tab-icon"><IconBlock name="house" size={19} /></span>
            <span>Home</span>
          </button>
          <button class="dk-tab" data-tab="Search">
            <span class="dk-tab-pill"></span>
            <span class="dk-tab-icon"><IconBlock name="search" size={19} /></span>
            <span>Search</span>
          </button>
          <button class="dk-tab" data-tab="Alerts">
            <span class="dk-tab-pill"></span>
            <span class="dk-tab-icon"><IconBlock name="bell" size={19} /></span>
            <span>Alerts</span>
          </button>
          <button class="dk-tab" data-tab="Account">
            <span class="dk-tab-pill"></span>
            <span class="dk-tab-icon"><IconBlock name="person" size={19} /></span>
            <span>Account</span>
          </button>
        </div>
        <span class="dk-tabbot-msg" data-tabs-msg>Home</span>
      </div>
    </div>
  )
}
<style>
  .colx {
    flex-direction: column;
  }
  .bbar {
    display: flex;
    gap: 8px;
    padding: 8px;
    border-radius: 20px;
    border: 1px solid var(--hair);
    background: color-mix(in srgb, var(--panel) 78%, transparent);
    backdrop-filter: blur(16px);
    box-shadow: var(--shadow-lg);
  }
  .bbar span {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    font-weight: 600;
    padding: 8px 13px;
    border-radius: 14px;
    color: var(--fg-secondary);
  }
  .bbar .tbactive {
    background: var(--accent);
    color: var(--accent-contrast);
    animation: tb-selected 4.8s ease-in-out infinite;
    box-shadow: 0 6px 18px color-mix(in srgb, var(--accent) 42%, transparent);
  }
  .bbar .tb {
    animation: tb-idle 4.8s ease-in-out infinite;
  }
  .bbar .tb:nth-of-type(3) { animation-delay: 0.2s; }
  .bbar .tb:nth-of-type(4) { animation-delay: 0.4s; }
  .icon {
    display: grid;
    place-items: center;
    width: 17px;
  }
  @keyframes tb-selected {
    0%, 18%, 100% { background: var(--accent); transform: translateY(0); }
    38%, 58% { background: transparent; color: var(--fg-secondary); }
  }
  @keyframes tb-idle {
    0%, 18%, 100% { opacity: 0.75; transform: translateY(0); }
    38%, 58% { opacity: 1; transform: translateY(-3px); background: var(--accent); color: var(--accent-contrast); }
  }
</style>