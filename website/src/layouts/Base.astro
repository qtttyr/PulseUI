---
import "../styles/global.css";
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/space-grotesk/wght.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/700.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "PULSE — premium SwiftUI components",
  description = "Copy-paste SwiftUI components, themed through tokens, beautifully animated. Live, open source, drop-in.",
} = Astro.props;

const navLinks = [
  { href: "/components/", label: "Components" },
  { href: "/playground/", label: "Playground" },
  { href: "/studio/", label: "Studio" },
  { href: "/docs/", label: "Docs" },
];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("pulse-theme");
        const theme =
          stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
        localStorage.setItem("pulse-theme", theme);
      })();
    </script>
    <script is:inline>
      window.__pulseTheme = () => {
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("pulse-theme", next);
        const btn = document.getElementById("theme-toggle");
        if (btn) btn.setAttribute("aria-label", `Switch to ${next === "dark" ? "light" : "dark"} mode`);
      };
      window.__pulseThemeSync = () => {
        const root = document.documentElement;
        const dark = root.dataset.theme === "dark";
        const btn = document.getElementById("theme-toggle");
        if (btn) btn.setAttribute("aria-label", `Switch to ${dark ? "light" : "dark"} mode`);
      };
      document.addEventListener("astro:page-load", () => window.__pulseThemeSync());
      window.__pulseMenu = () => {
        const menu = document.getElementById("mobile-menu");
        const btn = document.getElementById("menu-toggle");
        const open = menu.classList.toggle("open");
        btn.setAttribute("aria-expanded", String(open));
        btn.classList.toggle("open", open);
        document.body.style.overflow = open ? "hidden" : "";
      };
    </script>
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>

    <header class="nav">
      <div class="container nav-inner">
        <a href="/" class="brand" aria-label="PULSE home">
          <span class="brand-mark" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
          <span class="brand-name"><strong>PULSE</strong><sup>®</sup></span>
        </a>

        <nav class="nav-links" aria-label="Primary">
          {
            navLinks.map((l) => (
              <a class:list={["nav-link", { active: Astro.url.pathname === l.href }]} href={l.href}>
                {l.label}
              </a>
            ))
          }
        </nav>

        <div class="nav-actions">
          <a class="btn btn-accent nav-cta" href="/studio/">
            Open studio
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
          </a>
          <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme" onclick="window.__pulseTheme()">
            <span class="theme-sun" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" />
              </svg>
            </span>
            <span class="theme-moon" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" />
              </svg>
            </span>
          </button>
          <button id="menu-toggle" class="menu-toggle" aria-label="Open menu" aria-expanded="false" onclick="window.__pulseMenu()">
            <span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile">
      {
        navLinks.map((l) => (
          <a class:list={["mnav-link", { active: Astro.url.pathname === l.href }]} href={l.href}>
            {l.label}
          </a>
        ))
      }
      <a class="mnav-ghost" href="/studio/">Open studio →</a>
      <a class="mnav-ghost" href="/install/">Install</a>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <div class="brand-col">
          <span class="footer-wordmark">PULSE<span>.</span>UI</span>
          <p>
            A copy-paste component system for SwiftUI. Tokens, glass and
            springy motion — free forever, open source.
          </p>
          <a class="btn btn-outline" href="/install/">Install in 2 minutes</a>
        </div>
        <div class="foot-grid">
          <div class="foot-col">
            <h4>Library</h4>
            <a href="/components/">Components</a>
            <a href="/playground/">Playground</a>
            <a href="/studio/">Studio</a>
          </div>
          <div class="foot-col">
            <h4>Resources</h4>
            <a href="/install/">Install</a>
            <a href="/docs/">Docs</a>
            <a href="/license/">License</a>
          </div>
          <div class="foot-col">
            <h4>Community</h4>
            <a href="https://github.com/qtttyr/PulseUI" target="_blank" rel="noopener">GitHub</a>
            <a href="https://pulseuimk.vercel.app" target="_blank" rel="noopener">Website</a>
          </div>
        </div>
      </div>
      <div class="container footer-bar">
        <span>© {new Date().getFullYear()} Pulse UI</span>
        <span class="footer-live"><i class="alive-dot"></i> components are live on this site</span>
      </div>
    </footer>

    <style>
      .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        height: var(--nav-h);
        display: flex;
        align-items: center;
        backdrop-filter: blur(16px) saturate(150%);
        -webkit-backdrop-filter: blur(16px) saturate(150%);
        background: color-mix(in srgb, var(--bg) 76%, transparent);
        border-bottom: 1px solid var(--border);
      }

      .nav-inner {
        display: flex;
        align-items: center;
        gap: 26px;
        height: 100%;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 18px;
        letter-spacing: -0.02em;
        color: var(--fg);
      }
      .brand-name {
        font-family: var(--font-mono);
        letter-spacing: 0.02em;
        font-weight: 700;
      }
      .brand-name sup {
        color: var(--accent-ink);
        font-size: 9px;
        margin-left: 1px;
      }

      .brand-mark {
        display: inline-flex;
        align-items: flex-end;
        gap: 3px;
        height: 18px;
      }
      .brand-mark span {
        display: block;
        width: 5px;
        border-radius: 99px;
        background: var(--accent);
        animation: brand-bounce 1.4s var(--motion-bounce) infinite;
      }
      .brand-mark span:nth-child(1) {
        height: 7px;
        animation-delay: 0s;
      }
      .brand-mark span:nth-child(2) {
        height: 13px;
        animation-delay: 0.1s;
      }
      .brand-mark span:nth-child(3) {
        height: 18px;
        animation-delay: 0.2s;
      }
      @keyframes brand-bounce {
        0%,
        100% {
          transform: scaleY(1);
        }
        50% {
          transform: scaleY(0.45);
        }
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 2px;
        flex: 1;
      }
      .nav-link {
        padding: 7px 13px;
        border-radius: 9px;
        font-size: 14.5px;
        font-weight: 500;
        color: var(--fg-secondary);
        transition: color 0.15s ease, background-color 0.15s ease;
      }
      .nav-link:hover {
        color: var(--fg);
        background: var(--surface-muted);
      }
      .nav-link.active {
        color: var(--fg);
        background: var(--surface-muted);
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-left: auto;
      }

      .nav-cta {
        padding: 9px 15px;
        font-size: 14px;
      }

      .theme-toggle {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: var(--panel);
        color: var(--fg);
        cursor: pointer;
        transition: border-color 0.15s ease, background-color 0.15s ease;
      }
      .theme-toggle:hover {
        border-color: var(--border-strong);
      }
      .theme-toggle .theme-moon {
        display: none;
      }
      :root[data-theme="dark"] .theme-toggle .theme-sun {
        display: none;
      }
      :root[data-theme="dark"] .theme-toggle .theme-moon {
        display: block;
      }

      .menu-toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 38px;
        height: 38px;
        padding: 10px;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: transparent;
        cursor: pointer;
      }
      .menu-toggle span {
        display: block;
        height: 2px;
        border-radius: 99px;
        background: var(--fg);
        transition: transform 0.25s var(--motion-snappy), opacity 0.2s ease;
      }
      .menu-toggle.open span:first-child {
        transform: translateY(3.5px) rotate(45deg);
      }
      .menu-toggle.open span:last-child {
        transform: translateY(-3.5px) rotate(-45deg);
      }

      .mobile-menu {
        display: none;
        position: fixed;
        inset: var(--nav-h) 0 0;
        z-index: 40;
        flex-direction: column;
        gap: 4px;
        padding: 16px;
        background: color-mix(in srgb, var(--bg) 92%, transparent);
        backdrop-filter: blur(20px) saturate(160%);
        -webkit-backdrop-filter: blur(20px) saturate(160%);
        border-bottom: 1px solid var(--border);
        box-shadow: var(--shadow-lg);
      }
      .mobile-menu.open {
        display: flex;
      }
      .mnav-link {
        font-size: 17px;
        font-weight: 600;
        color: var(--fg-secondary);
        padding: 13px 14px;
        border-radius: 12px;
        transition: color 0.15s ease, background 0.15s ease;
      }
      .mnav-link:hover,
      .mnav-link.active {
        color: var(--fg);
        background: var(--surface-muted);
      }
      .mnav-ghost {
        margin-top: 6px;
        font-size: 15px;
        font-weight: 600;
        color: var(--accent-ink);
        padding: 13px 14px;
      }

      .footer {
        margin-top: 96px;
        background: var(--bg-soft);
        border-top: 1px solid var(--border);
        padding-block: 56px 24px;
      }

      .footer-inner {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 48px;
        align-items: start;
      }

      .footer-wordmark {
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: 28px;
        letter-spacing: -0.02em;
      }
      .footer-wordmark span {
        color: var(--accent-ink);
      }

      .brand-col p {
        margin: 10px 0 18px;
        max-width: 340px;
        color: var(--fg-secondary);
        font-size: 14.5px;
      }

      .foot-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
      }
      .foot-col {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .foot-col h4 {
        margin: 0 0 6px;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--fg-tertiary);
        font-weight: 600;
      }
      .foot-col a {
        font-size: 14.5px;
        color: var(--fg-secondary);
        transition: color 0.15s ease;
      }
      .foot-col a:hover {
        color: var(--fg);
      }

      .footer-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 44px;
        padding-top: 18px;
        border-top: 1px solid var(--border);
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--fg-tertiary);
      }
      .footer-live {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--fg-secondary);
      }

      .alive-dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        border-radius: 99px;
        background: var(--success);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 22%, transparent);
        animation: alive 2.2s ease infinite;
      }
      @keyframes alive {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.35;
        }
      }

      @media (max-width: 900px) {
        .nav-links {
          display: none;
        }
        .menu-toggle {
          display: flex;
        }
        .footer-inner {
          grid-template-columns: 1fr;
        }
      }
      @media (max-width: 640px) {
        .nav-cta {
          font-size: 0;
          padding-inline: 11px;
          gap: 0;
        }
        .nav-cta svg {
          margin: 0;
        }
        .footer-live {
          display: none;
        }
      }
    </style>
  </body>
</html>